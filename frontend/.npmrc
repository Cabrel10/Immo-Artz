# Cache npm en dehors du répertoire courant
# Par défaut : ~/.npm (répertoire utilisateur)
# Windows : C:\Users\<username>\AppData\Roaming\npm-cache
# Linux/Mac : ~/.npm

# Utiliser le cache système (optionnel, déjà par défaut)
cache=$APPDATA/npm-cache

# Alternative : utiliser un chemin personnalisé (décommenter)
# cache=D:\npm-cache

# Prefix global pour npm packages (optionnel)
# prefix=$APPDATA/npm-global

# Autres optimisations
legacy-peer-deps=true
fetch-timeout=120000
fetch-max-retries=3

# Production minimal
production=false
