###################################
# APPLICATION
###################################
APP_NAME=IMMO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###################################
# DATABASE (mysql, pgsql, sqlite)
###################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=immo
DB_USERNAME=root
DB_PASSWORD=

###################################
# CACHE / SESSION / QUEUE
###################################
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

###################################
# FILESYSTEM
###################################
FILESYSTEM_DISK=public
IMMO_UPLOAD_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

###################################
# MAIL
###################################
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@immo.cm"
MAIL_FROM_NAME="${APP_NAME}"

###################################
# CORS & SANCTUM
###################################
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

###################################
# CATALOGUE
###################################
CATALOG_PRICE=2000
CATALOG_PASSWORD_VALIDITY=12
CATALOG_PASSWORD_MAX_USES=100

###################################
# PAYMENT (fake | campay | notchpay)
###################################
PAYMENT_DRIVER=fake
PAYMENT_WEBHOOK_SECRET=

###################################
# GOOGLE OAUTH
###################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
